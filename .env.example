# Copy to .env and fill in. docker compose reads this file automatically.

# --- LogicMonitor portal --------------------------------------------------
# The part before .logicmonitor.com in your portal URL.
LOGICMONITOR_ACCOUNT=yourcompany
# LMv1 API token. Needs: manage DataSources (for alert thresholds), read
# Dashboards and Alerts, and ingest for Logs and Push Metrics.
LOGICMONITOR_ACCESS_ID=
LOGICMONITOR_ACCESS_KEY=
# Optional: keep the two credentials above in a separate root-only file
# instead, and point to it here. Leave unset to read them from this file.
#LM_ENV_FILE=/etc/lm-demo/credentials.env

# --- Where traces go ------------------------------------------------------
# OTLP/HTTP endpoint of a LogicMonitor OTel collector (lmotel). The console
# posts JSON to <LMOTEL_URL>/v1/traces. Use the host's LAN address, not
# localhost, because the console runs in its own container.
LMOTEL_URL=http://192.168.1.10:4318

# --- The console itself ---------------------------------------------------
# Address and port the web page is published on. 127.0.0.1 keeps it local;
# use the host's LAN address to reach it from a laptop. There is no login,
# so never publish it to the internet.
BIND_ADDR=127.0.0.1
CONSOLE_PORT=8089
CONTAINER_NAME=lm-demo
# --- Your sites, host and business scenarios --------------------------------
# Either put the whole config here as ONE line of JSON in single quotes (same
# shape as config/demo.example.json), which keeps everything in this file:
#DEMO_CONFIG_JSON='{"title":"Acme","host":{...},"sites":[...],"business":{...}}'
# or leave DEMO_CONFIG_JSON unset and use config/demo.json in this folder:
CONFIG_DIR=./config

# --- Behaviour ------------------------------------------------------------
# Default length of a scenario in minutes (the page can override it).
DEMO_DURATION_MIN=10
# Push calm values for the Demo_* datasources every minute while no scenario
# drives them, so dashboards never show "no data" between runs.
DEMO_BASELINE=true
# Let Push Metrics create a resource that doesn't exist yet. Leave false when
# your resources already exist (from a collector or the OTel pipeline).
LM_CREATE_RESOURCES=false
